APP_NAME="Smart Syndic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# ─── Database (PostgreSQL 16+) ───────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smart_syndic
DB_USERNAME=postgres
DB_PASSWORD=

# ─── Redis (Rate Limiting + Queue + Cache) ───────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# ─── Sanctum (API Auth) ──────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000
SESSION_DOMAIN=localhost

# ─── Storage (S3-Compatible) ─────────────────────────────────────────
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=smartsyndic-uploads
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Mail (Transactional) ────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@smartsyndic.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Firebase Cloud Messaging (FCM) ──────────────────────────────────
FCM_CREDENTIALS_PATH=storage/app/firebase-credentials.json
FCM_PROJECT_ID=

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ─── PDF Generation (wkhtmltopdf via Snappy) ─────────────────────────
SNAPPY_PDF_BINARY=/usr/local/bin/wkhtmltopdf
SNAPPY_IMAGE_BINARY=/usr/local/bin/wkhtmltoimage

# ─── Payment Gateway (CMI / Payzone) ─────────────────────────────────
CMI_MERCHANT_ID=
CMI_SECRET_KEY=
CMI_STORE_KEY=
CMI_GATEWAY_URL=

# ─── Horizon ──────────────────────────────────────────────────────────
HORIZON_PREFIX=smartsyndic_horizon:

# ─── Rate Limiting Defaults ──────────────────────────────────────────
RATE_LIMIT_AUTH=5
RATE_LIMIT_INVITE_CODE=10
RATE_LIMIT_API=60
RATE_LIMIT_FINANCIAL=15

# ─── Logging ──────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
